model Room {
  id            Int       @id @default(autoincrement())
  roomNumber    Int
  roomType      RoomType
  pricePerNight Decimal
  hotelId       Int
  bookings      Booking[]
  hotel         Hotel     @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, roomNumber])
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
}
