model Service {
  id           String   @id @default(uuid())
  title        String
  description  String
  price        Decimal
  availability Boolean  @default(true)
  providerId   String
  createAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  provider     Account  @relation(fields: [providerId], references: [id])
}
